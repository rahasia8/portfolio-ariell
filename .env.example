# Copy to .env.local. Without credentials, chat returns an honest empty-state response.
DATABASE_URL=postgresql://portfolio:portfolio@localhost:5432/portfolio
# Chat uses Groq Free: create a server-side key at https://console.groq.com/keys
# Full-text retrieval and ingestion need no embedding service or API key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Public production origin when the hosting proxy uses an internal request URL.
APP_ORIGIN=
TOP_K=5
MAX_MESSAGE_LENGTH=2000
RATE_LIMIT_PER_MINUTE=12
# Set true only behind a trusted reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
NEXT_PUBLIC_OWNER_NAME=Ariell Zaki Prabaswara Ariza
NEXT_PUBLIC_OWNER_ROLE=Software Engineer

# Country-based language: none (visitor-side IP lookup), vercel, or cloudflare.
# Select a provider only when its proxy overwrites its country header.
LOCATION_PROVIDER=none
